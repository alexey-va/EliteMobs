+package com.magmaguy.elitemobs.advancedcombat.passives;
+
+import com.magmaguy.elitemobs.advancedcombat.content.BuiltInClassContent;
+import com.magmaguy.elitemobs.advancedcombat.progression.ActiveLineageSnapshot;
+import org.junit.jupiter.api.Test;
+
+import java.util.Set;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class PassiveOnlyRegistryTest {
+    private final FixedPassiveRegistry registry = BuiltInClassContent.passiveRegistry();
+    private static final Set<PassiveCondition> REMOVED_CONDITIONS = Set.of(
+            PassiveCondition.CLASS_ABILITY_DAMAGE, PassiveCondition.AREA_CLASS_ABILITY_DAMAGE,
+            PassiveCondition.TRAP_CLASS_ABILITY_DAMAGE, PassiveCondition.BLAST_CLASS_ABILITY_DAMAGE,
+            PassiveCondition.WARD_BROKEN, PassiveCondition.TARGET_CONTROLLED, PassiveCondition.TARGET_UNCONTROLLED);
+
+    @Test
+    void everyFormHasAnOrdinaryCombatBenefitAndNoAbilityDependentEffects() {
+        assertEquals(76, registry.mappedFormIds().size());
+        for (String id : registry.mappedFormIds()) {
+            for (int level : new int[]{1, 30, 100}) {
+                var baseline = registry.require(id).atContributionLevel(level);
+                assertOrdinary(baseline);
+                boolean benefit = beneficial(baseline);
+                for (var trait : registry.traits(id)) {
+                    assertTrue(trait.conditions().stream().noneMatch(REMOVED_CONDITIONS::contains), id);
+                    var contribution = trait.profile().atContributionLevel(level);
+                    assertOrdinary(contribution);
+                    benefit |= beneficial(contribution);
+                    if (contribution.healingReceived() != 0D || contribution.movementSpeed() != 0D)
+                        assertTrue(trait.conditions().stream().noneMatch(condition ->
+                                condition.name().startsWith("TARGET_") || condition == PassiveCondition.SPELL_DAMAGE
+                                        || condition == PassiveCondition.RANGED_ATTACK), id);
+                }
+                for (var trait : registry.mechanicTraits(id)) {
+                    var mechanics = trait.atContributionLevel(level);
+                    assertEquals(new PassiveMechanics(1, 1, 1, 1, 1, 1, 1, 1, 1,
+                            mechanics.controlResistanceFraction(), mechanics.partyMovementSpeedAdjustment()), mechanics);
+                    benefit |= mechanics.controlResistanceFraction() > 0
+                            || mechanics.partyMovementSpeedAdjustment() > 0;
+                }
+                assertTrue(benefit, id + " must not be empty or solely a penalty at " + level);
+            }
+        }
+    }
+
+    @Test
+    void representativePerksUseExactContributionLevelsAndWorkingWeaponConditions() {
+        var ordinary = context(false, 1D);
+        var magic = context(true, 1D);
+        var occultist = aggregate("occultist", 31);
+        assertEquals(1.04145D, occultist.evaluate(ordinary).outgoingDamageMultiplier(), 1E-9);
+        assertEquals(1.06103D, occultist.evaluate(magic).outgoingDamageMultiplier(), 1E-9);
+        assertEquals(.99D, occultist.evaluate(ordinary).healingReceivedMultiplier(), 1E-9);
+        assertEquals(1.05708D, aggregate("mage", 31).evaluate(magic).outgoingDamageMultiplier(), 1E-9);
+        assertEquals(1.0455D, aggregate("cleric", 1).evaluate(ordinary).healingReceivedMultiplier(), 1E-9);
+        assertEquals(1.02535D, aggregate("berserker", 1).evaluate(ordinary).outgoingDamageMultiplier(), 1E-9);
+        assertTrue(aggregate("bloodrager", 31).evaluate(context(false, .2D)).outgoingDamageMultiplier()
+                > aggregate("bloodrager", 31).evaluate(ordinary).outgoingDamageMultiplier());
+    }
+
+    private static void assertOrdinary(PassiveProfile.Contribution contribution) {
+        assertEquals(0D, contribution.healingDone());
+        assertEquals(0D, contribution.abilityCostReduction());
+    }
+
+    private static boolean beneficial(PassiveProfile.Contribution contribution) {
+        return contribution.outgoingDamage() > 0 || contribution.incomingDamage() < 0
+                || contribution.movementSpeed() > 0 || contribution.healingReceived() > 0;
+    }
+
+    private PassiveAggregate aggregate(String id, int effectiveLevel) {
+        var lineage = BuiltInClassContent.catalog().lineageOf(id);
+        return PassiveAggregate.resolve(lineage, new ActiveLineageSnapshot(id,
+                lineage.activeForm().band().toLocalLevel(effectiveLevel), effectiveLevel,
+                lineage.formIds(), lineage.passiveContributionLevels(effectiveLevel)), registry);
+    }
+
+    private static PassiveConditionContext context(boolean magicWeapon, double health) {
+        return new PassiveConditionContext(health, false, false, false,
+                true, 1D, false, false, true, false, 10D,
+                false, false, false, magicWeapon, false, false);
+    }
+}
