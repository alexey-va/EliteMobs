@@ -0,0 +1,110 @@
+package com.magmaguy.elitemobs.advancedcombat;
+
+import com.magmaguy.elitemobs.MetadataHandler;
+import com.magmaguy.elitemobs.advancedcombat.abilities.AbilityContribution;
+import com.magmaguy.elitemobs.advancedcombat.abilities.AbilityFailureReason;
+import com.magmaguy.elitemobs.advancedcombat.classes.AbilitySlot;
+import com.magmaguy.elitemobs.advancedcombat.input.ClassAbilityInputRouter;
+import org.bukkit.Bukkit;
+import org.bukkit.Material;
+import org.bukkit.attribute.Attribute;
+import org.bukkit.block.BlockFace;
+import org.bukkit.event.HandlerList;
+import org.bukkit.event.block.Action;
+import org.bukkit.event.entity.EntityRegainHealthEvent;
+import org.bukkit.event.player.PlayerInteractEvent;
+import org.bukkit.event.player.PlayerItemHeldEvent;
+import org.bukkit.event.player.PlayerSwapHandItemsEvent;
+import org.bukkit.inventory.ItemStack;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class PassiveOnlyClassBehaviorTest extends CombatBehaviorFixture {
+    @Test
+    void everyNativeClassRejectsDirectCastsWithoutResourcesOrEffects() {
+        fullCombatActive = true;
+        int entities = player.getWorld().getEntities().size();
+        for (var form : module.catalog().forms()) {
+            assertTrue(module.setClassLevelForAdministration(
+                    player, form.id(), form.band().effectiveStart()).applied(), form.id());
+            var before = module.profile(player.getUniqueId()).orElseThrow();
+            for (var slot : AbilitySlot.values()) {
+                var result = module.useAbility(player, slot);
+                assertFalse(result.successful(), form.id() + "/" + slot);
+                assertEquals(AbilityFailureReason.INVALID_PLAYER, result.failureReason());
+                assertEquals(AbilityContribution.NONE, result.contribution());
+                assertFalse(result.continuesAsynchronously());
+                assertTrue(AdvancedCombatModule.abilityResourceSnapshot(player, slot).isEmpty());
+            }
+            assertEquals(before, module.profile(player.getUniqueId()).orElseThrow());
+        }
+        assertEquals(76, module.catalog().forms().size());
+        assertEquals(entities, player.getWorld().getEntities().size());
+        assertTrue(AdvancedCombatModule.resourceSnapshot(player.getUniqueId()).isEmpty());
+        assertTrue(AdvancedCombatModule.abilityEvidence(player.getUniqueId()).isEmpty());
+    }
+
+    @Test
+    void gameplayRegistersNoClassInputAndLeavesVanillaWeaponInputsAvailable() {
+        fullCombatActive = true;
+        assertTrue(module.selectForm(player, "ranger").accepted());
+        assertTrue(HandlerList.getRegisteredListeners(MetadataHandler.PLUGIN).stream()
+                .noneMatch(listener -> listener.getListener() instanceof ClassAbilityInputRouter));
+        for (boolean sneaking : new boolean[]{false, true}) {
+            player.setSneaking(sneaking);
+            for (int press = 0; press < 2; press++) {
+                var swap = new PlayerSwapHandItemsEvent(player, null, null);
+                Bukkit.getPluginManager().callEvent(swap);
+                assertFalse(swap.isCancelled());
+            }
+        }
+        var hotbar = new PlayerItemHeldEvent(player, 0, 1);
+        Bukkit.getPluginManager().callEvent(hotbar);
+        assertFalse(hotbar.isCancelled());
+        for (Action action : new Action[]{Action.LEFT_CLICK_BLOCK, Action.RIGHT_CLICK_BLOCK}) {
+            var click = new PlayerInteractEvent(player, action, new ItemStack(Material.STONE_SWORD),
+                    player.getWorld().getBlockAt(0, 64, 0), BlockFace.UP);
+            var itemUse = click.useItemInHand();
+            var blockUse = click.useInteractedBlock();
+            Bukkit.getPluginManager().callEvent(click);
+            assertEquals(itemUse, click.useItemInHand());
+            assertEquals(blockUse, click.useInteractedBlock());
+        }
+        assertFalse(AdvancedCombatModule.isAbilityGestureOpen(player.getUniqueId()));
+        assertFalse(ClassAbilityEligibility.isEligible(player));
+    }
+
+    @Test
+    void passivesReconcileWithoutClassControlsAndReleaseTheirAttributes() {
+        var movement = player.getAttribute(Attribute.MOVEMENT_SPEED);
+        double baseMovement = movement.getBaseValue();
+        fullCombatActive = true;
+        assertTrue(module.selectForm(player, "ranger").accepted());
+        assertFalse(module.fLayerSupported(player));
+        assertFalse(module.controlsAlwaysAvailable(player));
+        assertFalse(module.outsideControlsAllowed());
+        assertTrue(module.mechanicsActive(player));
+        assertEquals(baseMovement * 1.06075D, movement.getValue(), 1E-9);
+        assertEquals(10.152D, outgoingDamage(), 1E-9);
+
+        fullCombatActive = false;
+        module.onControlModeChanged(player);
+        assertFalse(module.mechanicsActive(player));
+        assertEquals(baseMovement, movement.getValue(), 1E-9);
+        assertEquals(10D, outgoingDamage(), 1E-9);
+    }
+
+    @Test
+    void clericPassiveBoostsOrdinaryReceivedHealingWithoutCasting() {
+        fullCombatActive = true;
+        assertTrue(module.selectForm(player, "cleric").accepted());
+        var healing = new EntityRegainHealthEvent(player, 10D, EntityRegainHealthEvent.RegainReason.CUSTOM);
+        Bukkit.getPluginManager().callEvent(healing);
+        assertEquals(10.455D, healing.getAmount(), 1E-9);
+        assertTrue(module.clearSelectedForm(player).accepted());
+        var classless = new EntityRegainHealthEvent(player, 10D, EntityRegainHealthEvent.RegainReason.CUSTOM);
+        Bukkit.getPluginManager().callEvent(classless);
+        assertEquals(10D, classless.getAmount(), 1E-9);
+    }
+}
